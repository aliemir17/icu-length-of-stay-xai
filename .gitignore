# Data — never commit MIMIC raw data (PhysioNet DUA)
data/raw/
data/processed/
data/interim/
*.csv
*.csv.gz
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# Keep synthetic data and small test fixtures
!data/synthetic/
!tests/fixtures/

# Models and artifacts (recursive — covers models/ and any subdirectory)
models/**/*.joblib
models/*.joblib
models/**/*.pkl
models/*.pkl
models/**/*.json
models/*.json
*.onnx

# Reports — figures recursive (covers reports/figures/ and reports/baseline/figures/)
reports/**/*.png
reports/**/*.pdf
reports/figures/*.png
reports/figures/*.pdf
!reports/figures/.gitkeep

# Logs
*.log
logs/

# Environment / secrets
.env
.env.local
config.local.py

